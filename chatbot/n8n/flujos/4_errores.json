      "id": "d5e8afb5-2b87-4b14-acb2-93a4c3b97960",
      "name": "Configuración",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "notes": "Valores del entorno. Edítalos aquí después de importar (o en config.local.json y vuelve a generar)."
    },
    {
      "parameters": {
        "jsCode": "\n// ---- n8n ----\n// Registra etapa y causa sin credenciales: se tachan tokens, claves y cabeceras de autorización.\nconst e = $('Error Trigger').first().json;\nconst limpiar = v => String(v ?? '')\n  .replace(/(bearer|token|access_token|authorization|password|secret|apikey|api_key)([\"':=\\s]+)[^\\s\"',}]+/gi, '$1$2[oculto]')\n  .replace(/EAA[A-Za-z0-9]{20,}/g, '[token oculto]')\n  .slice(0, 500);\nreturn [{ json: {\n  fecha: new Date().toISOString(),\n  flujo: e.workflow?.name || '',\n  nodo: e.execution?.lastNodeExecuted || e.trigger?.error?.node?.name || '',\n  mensaje: limpiar(e.execution?.error?.message || e.trigger?.error?.message),\n  ejecucion_id: String(e.execution?.id || ''),\n  modo: e.execution?.mode || '',\n} }];"
      },
      "id": "667370c0-cdae-4fe8-ad75-d53c81fde88f",
      "name": "Preparar registro",
