# Copia este archivo como .env (cp env.example .env) para correr en local con npm run dev.
# En Render se cargan en el servicio › Environment. El .env nunca se sube (está en .gitignore).
# Sin GOOGLE_* el backend funciona igual, con los datos en memoria (se pierden al reiniciar).

# Puerto (Render lo pone solo).
PORT=3000

# Dominio(s) del frontend que pueden llamar a la API, separados por coma. "*" = cualquiera (solo para pruebas).
FRONTEND_ORIGIN=http://localhost:5173

# Hoja de Google Sheets donde se guardan Config, Catalogo, Pedidos, Clientes, Notificaciones, Conversaciones,
# Fuentes y Ventas (las pestañas se crean solas). Es la parte entre /d/ y /edit de la URL.
# Compártela con el client_email de la cuenta de servicio como EDITOR.
GOOGLE_SHEET_ID=

# JSON de la cuenta de servicio de Google Cloud (Sheets API y Drive API habilitadas), en una sola línea o en base64.
GOOGLE_SERVICE_ACCOUNT_JSON=

# true = la hoja nace con 6 pedidos y 2 avisos de ejemplo (marcados como ejemplo). false = empieza vacía.
SEMBRAR_EJEMPLOS=true

# Zona horaria para "hoy", fechas cercanas y el resumen diario.
TZ=America/Lima
