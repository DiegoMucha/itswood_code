# Backend en Render. Si queda vacío, la app funciona en "Modo ejemplo".
VITE_API_URL=
# Landing de Priora en Vercel
VITE_LANDING_URL=
# Web de la tienda (botón del mensaje de bienvenida)
VITE_WEB_TIENDA_URL=https://itswood.pe
# Contraseña de la cuenta de demo (joaquinsito@gmail.com) SOLO para el "Modo ejemplo" (sin backend).
# Ojo: toda variable VITE_ queda dentro del JavaScript publicado, así que esto NO es un secreto: solo evita que la
# demo sin backend quede abierta. Vacía = el modo ejemplo entra sin login, como antes.
# Con backend, la contraseña real es ADMIN_PASSWORD del backend (Render) y esta variable no se usa.
VITE_DEMO_PASSWORD=
